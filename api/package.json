{
  "name": "calendar-api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsp compile .",
    "build:fresh": "node scripts/clean-fresh.mjs && tsp compile . --option \"@typespec/openapi3.emitter-output-dir={project-root}/.tmp/openapi\"",
    "drift": "node scripts/check-drift.mjs",
    "format": "tsp format \"**/*.tsp\"",
    "format:check": "tsp format --check \"**/*.tsp\""
  },
  "dependencies": {
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/openapi3": "1.17.0"
  }
}
