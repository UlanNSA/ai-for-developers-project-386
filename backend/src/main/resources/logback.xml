<configuration>
    <!-- INFO instead of logback's default DEBUG: Netty/Ktor DEBUG output is hundreds of lines at start-up
         and costs CPU on a small instance (Render Free). -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
